# Copy to .env (next to docker-compose.yml) and fill in. Never commit .env.
#
# ⚠️ Postgres and pgAdmin use these only when their volume is first created.
#    Changing them later doesn't change existing passwords; see README.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
PGADMIN_EMAIL=you@example.com          # pgAdmin's own login; any email-shaped value works
PGADMIN_PASSWORD=change-me
