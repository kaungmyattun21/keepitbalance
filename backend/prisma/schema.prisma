// KeepItTrack database schema
// Docs: https://pris.ly/d/prisma-schema
//
// Conventions used below:
//   - Models/fields are camelCase in TypeScript, mapped to snake_case in PostgreSQL
//     with @map (columns) and @@map (tables/enums).
//   - Every id is a uuid generated by the database (gen_random_uuid()).
//   - Timestamps are timestamptz(3) (an absolute instant, millisecond precision).
//   - Money is Decimal(12,2), quantities Decimal(10,2), never Float.
//   - Rules Prisma's schema language can't express (CHECK constraints, partial and
//     expression indexes) live in a raw-SQL migration: prisma/migrations/*_db_rules.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TransactionType {
  INCOME
  EXPENSE

  @@map("transaction_type")
}

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
  SNACK

  @@map("meal_slot")
}

enum ShoppingListStatus {
  OPEN
  COMPLETED

  @@map("shopping_list_status")
}

// ---------------------------------------------------------------------------
// Auth — tables managed by Better Auth (D-018). Field names must match what
// Better Auth expects (name, emailVerified, token, providerId, ...); only the
// column names are ours (@map). Change them only together with src/modules/auth/auth.ts.
// ---------------------------------------------------------------------------

model User {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  email            String   @unique // stored lowercase by Better Auth
  emailVerified    Boolean  @default(false) @map("email_verified")
  image            String? // avatar URL, e.g. from Google
  dailyCalorieGoal Int      @default(2000) @map("daily_calorie_goal")
  dailyWaterGoalMl Int      @default(2000) @map("daily_water_goal_ml")
  timezone         String   @default("UTC") // IANA name, e.g. "Asia/Bangkok"
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions        Session[]
  accounts        Account[]
  categories      Category[]
  transactions    Transaction[]
  ingredients     Ingredient[]
  recipes         Recipe[]
  pantryItems     PantryItem[]
  mealPlanEntries MealPlanEntry[]
  shoppingLists   ShoppingList[]
  waterLogs       WaterLog[]

  @@map("users")
}

// One row per logged-in browser. The cookie holds `token`; logout deletes the row.
model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// One row per sign-in method of a user (D-019).
//   providerId "credential": accountId = user id, password = argon2 hash
//   providerId "google":     accountId = Google's user id, OAuth tokens
model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  providerId            String    @map("provider_id")
  accountId             String    @map("account_id")
  password              String?
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId]) // one local account per provider identity
  @@index([userId])
  @@map("accounts")
}

// Short-lived tokens: email verification, password reset, OAuth state.
model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------------------
// Finance
// ---------------------------------------------------------------------------

model Category {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  type      TransactionType
  name      String
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, type, name]) // no duplicate names per user + type (FR-3)
  @@unique([id, userId, type]) // target of the composite FK on Transaction
  @@map("categories")
}

model Transaction {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  categoryId     String          @map("category_id") @db.Uuid
  shoppingListId String?         @unique @map("shopping_list_id") @db.Uuid // set when created by "finish shopping"
  type           TransactionType
  amount         Decimal         @db.Decimal(12, 2) // always > 0; `type` decides the sign
  date           DateTime        @db.Date // calendar day in the user's time zone
  note           String?
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Composite FK: the category must belong to the SAME user and have the SAME type.
  category     Category      @relation(fields: [categoryId, userId, type], references: [id, userId, type], onDelete: Restrict, map: "transactions_category_fkey")
  shoppingList ShoppingList? @relation(fields: [shoppingListId], references: [id], onDelete: NoAction)

  @@index([userId, date])
  @@map("transactions")
}

// ---------------------------------------------------------------------------
// Groceries & Meals
// ---------------------------------------------------------------------------

model Ingredient {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  unit      String // "g", "ml", "pcs", ...
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeIngredients RecipeIngredient[]
  pantryItems       PantryItem[]
  shoppingListItems ShoppingListItem[]

  // Exact-name uniqueness (lets Prisma do findUnique/upsert by { userId, name }).
  // A stricter case-insensitive index on lower(name) is added in the db_rules migration.
  @@unique([userId, name])
  @@map("ingredients")
}

model Recipe {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  name               String
  servings           Int
  steps              String   @default("")
  caloriesPerServing Int      @map("calories_per_serving")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredients     RecipeIngredient[]
  mealPlanEntries MealPlanEntry[]

  @@index([userId])
  @@map("recipes")
}

// Join table: which ingredients a recipe needs (quantity is for the recipe's full servings).
model RecipeIngredient {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipeId     String   @map("recipe_id") @db.Uuid
  ingredientId String   @map("ingredient_id") @db.Uuid
  quantity     Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([recipeId, ingredientId])
  @@index([ingredientId])
  @@map("recipe_ingredients")
}

model PantryItem {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  ingredientId String   @map("ingredient_id") @db.Uuid
  quantity     Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([userId, ingredientId]) // one pantry row per ingredient
  @@index([ingredientId])
  @@map("pantry_items")
}

model MealPlanEntry {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  recipeId  String   @map("recipe_id") @db.Uuid
  date      DateTime @db.Date
  slot      MealSlot
  servings  Int
  eaten     Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Restrict)

  @@index([userId, date])
  @@index([recipeId])
  @@map("meal_plan_entries")
}

model ShoppingList {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  weekStart   DateTime           @map("week_start") @db.Date
  status      ShoppingListStatus @default(OPEN)
  completedAt DateTime?          @map("completed_at") @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       ShoppingListItem[]
  transaction Transaction? // the expense that paid for this list (0 or 1)

  // "Only one OPEN list per user" is a partial unique index in the db_rules migration.
  @@index([userId, weekStart])
  @@map("shopping_lists")
}

model ShoppingListItem {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shoppingListId String   @map("shopping_list_id") @db.Uuid
  ingredientId   String   @map("ingredient_id") @db.Uuid
  quantity       Decimal  @db.Decimal(10, 2)
  checked        Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  shoppingList ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  ingredient   Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([shoppingListId, ingredientId])
  @@index([ingredientId])
  @@map("shopping_list_items")
}

// ---------------------------------------------------------------------------
// Health
// ---------------------------------------------------------------------------

model WaterLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  amountMl  Int      @map("amount_ml") // stored in ml, shown as cups (250 ml)
  loggedAt  DateTime @default(now()) @map("logged_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
  @@map("water_logs")
}
