# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/keepitbalance?schema=public"

NODE_ENV=development
PORT=3000
WEB_URL=http://localhost:5173

# Better Auth. Secret: random, at least 32 chars. Generate with: openssl rand -base64 48
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Google sign-in (optional). Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/v1/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
